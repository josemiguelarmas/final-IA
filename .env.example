# Configuración de Entorno - Consultorio Jurídico Mantis AI MVP
# Copie este archivo como .env y ajuste según su entorno

# Aplicación
APP_NAME="Consultorio Jurídico Mantis AI MVP"
APP_VERSION="1.0.0"
DEBUG=true
PORT=8000

# Base de Datos (SQLite para desarrollo, PostgreSQL para producción en Linux)
DATABASE_URL="sqlite:///./consultorio_juridico.db"
# DATABASE_URL="postgresql://usuario:password@localhost:5432/consultorio_db"

# Motor de Inteligencia Artificial Local (Zero APIs de pago)
# Si Ollama está instalado y ejecutándose localmente:
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
AI_TIMEOUT_SECONDS=8.0

# Si se desea forzar el motor de reglas locales sin consultar Ollama:
FORCE_RULE_ENGINE=false

# Integración con Mantis Bug Tracker
# Modo actual del MVP: "mock" (utiliza expedientes de prueba fidedignos de Icesi)
# Modo producción institucional: "http" (requiere token otorgado por SYRI)
MANTIS_ADAPTER_TYPE="mock"
MANTIS_BASE_URL="https://www.icesi.edu.co/consultorio-juridico-app"
MANTIS_API_TOKEN=""

# Identidad Institucional
INSTITUTION_NAME="Universidad Icesi - Consultorio Jurídico"
DEFAULT_SUPERVISOR_NAME="Marcela Andrea Ríos Salazar"
DEFAULT_SUPERVISOR_EMAIL="mrios@example.edu.co"
